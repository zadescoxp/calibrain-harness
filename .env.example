# Copy to .env and fill in the keys (or paste them later in the terminal: KEYS).
# .env is gitignored and written with owner-only permissions.

# Which classification model decides: kairos | jev (switchable later in the terminal: MODEL)
CTB_MODEL_PROVIDER=kairos

# Kairos (Minara Cloud). Key must belong to a Kairos-enabled group.
KAIROS_API_KEY=
# KAIROS_BASE_URL=https://minara.cloud

# Jev (TypeSafe, https://console.typesafe.ai/keys). Version pinned so results never mix releases.
TYPESAFE_API_KEY=
# CTB_JEV_MODEL=jev-1.14.0

# Bybit TESTNET keys (https://testnet.bybit.com/app/user/api-management)
# Permissions: Contract -> Orders + Positions. NO withdraw.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Markets / cadence (Run 3 setup). Change symbols later in the terminal: UNIV
CTB_SYMBOLS=BTCUSDT,ETHUSDT,HYPEUSDT,XRPUSDT,SOXLUSDT,SOLUSDT,XAUUSDT
CTB_DECISION_TF=5
CTB_HORIZON_BARS=24
CTB_ATR_TF=15

# Trading. Starts observe-only; switch AUTO-TRADE on in the terminal to place testnet orders.
CTB_TRADING_ENABLED=0
# 0 = strict calibrated policy only (Run 3); 1 = also trade Kairos's preferred side at reduced risk
CTB_EXPLORATION=0
CTB_RISK_PER_TRADE_PCT=0.5
CTB_MAX_LEVERAGE=3
CTB_MAX_POSITIONS=10
CTB_MAX_OPEN_RISK_PCT=2
CTB_MAX_SAME_SIDE=4

# Execution on thin testnet books
CTB_MAX_ENTRY_SLIP_BP=10
CTB_EXIT_MODE=managed

# Model request budget. Mirror averaging doubles requests: 7 symbols on 5m bars need ~180/h, on 1m ~900/h
CTB_KAIROS_MAX_RPH=200

# Strategy v3 (also in the terminal: STRAT). Changing these while flat starts a new run.
# vol: stop = SL_SIGMA x GARCH sigma over the horizon | atr: legacy 1.5 x ATR
CTB_BRACKET_MODE=vol
CTB_SL_SIGMA=1.0
CTB_REWARD_RISK=1.5
# expected cost <= 20% of the stop; the horizon extends when this binds
CTB_MAX_COST_R=0.2
# maker: post-only at best bid/ask | taker: capped IOC
CTB_ENTRY_MODE=maker
CTB_MAKER_WAIT_S=20
# average every answer with the mirrored market's answer
CTB_SYMMETRIZE=1
# events: trade only on bars with a market event | every_bar
CTB_TRADE_TRIGGER=events
# model | flow | agree
CTB_DIRECTION_SOURCE=model
CTB_REQUIRE_BIG_MOVE=1
# strict trades only on symbols with out-of-sample skill (VALID screen)
CTB_REQUIRE_VALIDATED=1
# base | pause | alert
CTB_DRIFT_ACTION=base
CTB_DYNAMIC_SIZING=1
# stop to break-even after +1R (0 = off)
CTB_BE_TRIGGER_R=1.0
# extra models blended with the primary
# CTB_ENSEMBLE=kairos
# e.g. trend_up/normal_vol,range/low_vol
# CTB_ALLOWED_REGIMES=
