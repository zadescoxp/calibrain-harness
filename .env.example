# Copy to .env and fill in the keys, or skip this file: every setting below can be changed in the
# terminal (KEYS, CONFIG, STRATEGY, UNIV, TRADE TF, MODEL) and is saved back here automatically.
# .env is gitignored and written with owner-only permissions.

# Which classification model decides: kairos | jev (switchable later in the terminal: MODEL)
CTB_MODEL_PROVIDER=kairos

# Kairos (Minara Cloud). Key must belong to a Kairos-enabled group.
KAIROS_API_KEY=
# KAIROS_BASE_URL=https://minara.cloud

# Jev (TypeSafe, https://console.typesafe.ai/keys). Version pinned so results never mix releases.
TYPESAFE_API_KEY=
# CTB_JEV_MODEL=jev-1.14.0

# Order venue (demo accounts only; there is no live-funds venue):
#   demo    = Bybit Demo Trading: demo funds on the MAINNET market. Keys: log in at bybit.com, switch to
#             "Demo Trading" (avatar menu), then avatar -> API. Testnet keys do not work here.
#   testnet = api-testnet.bybit.com, its own thin book. Keys: https://testnet.bybit.com/app/user/api-management
# Changing the venue starts a new run (testnet and demo results are never pooled).
CTB_VENUE=demo
# demo: book every trade at the worse of Bybit's fill/fees and the real mainnet book walk, the fee
# schedule below, plus funding (Bybit's closed-PnL excludes funding). Off = book Bybit's numbers as-is.
CTB_COST_REALISM=1
# CTB_TAKER_FEE_BP=5.5
# CTB_MAKER_FEE_BP=2.0
# CTB_STOP_SLIP_BP=5

# Bybit keys, one pair per venue, so switching venue (CONFIG or KEYS in the terminal) never asks again.
# Permissions: Contract -> Orders + Positions. NO withdraw. Easier: paste them in the terminal (KEYS).
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
# (the old BYBIT_API_KEY / BYBIT_API_SECRET pair still works and is read as the testnet pair)

# Markets / cadence (Run 3 setup). Change symbols later in the terminal: UNIV
CTB_SYMBOLS=BTCUSDT,ETHUSDT,HYPEUSDT,XRPUSDT,SOXLUSDT,SOLUSDT,XAUUSDT
CTB_DECISION_TF=5
CTB_HORIZON_BARS=24
CTB_ATR_TF=15

# Trading. Starts observe-only; switch AUTO-TRADE on in the terminal to place orders on the venue.
CTB_TRADING_ENABLED=0
# 0 = strict calibrated policy only (Run 3); 1 = also trade Kairos's preferred side at reduced risk
CTB_EXPLORATION=0
CTB_RISK_PER_TRADE_PCT=0.5
CTB_MAX_LEVERAGE=3
CTB_MAX_POSITIONS=10
CTB_MAX_OPEN_RISK_PCT=2
CTB_MAX_SAME_SIDE=4

# Execution caps (entry IOC cap past the best price; managed exits)
CTB_MAX_ENTRY_SLIP_BP=10
CTB_EXIT_MODE=managed

# Model request budget. Mirror averaging doubles requests: 7 symbols on 5m bars need ~180/h, on 1m ~900/h
CTB_KAIROS_MAX_RPH=200

# Strategy v3 (also in the terminal: STRAT). Changing these while flat starts a new run.
# vol: stop = SL_SIGMA x GARCH sigma over the horizon | atr: legacy 1.5 x ATR
CTB_BRACKET_MODE=vol
CTB_SL_SIGMA=1.0
CTB_REWARD_RISK=1.5
# expected cost <= 20% of the stop; the horizon extends when this binds
CTB_MAX_COST_R=0.2
# maker: post-only at best bid/ask | taker: capped IOC
CTB_ENTRY_MODE=maker
CTB_MAKER_WAIT_S=20
# average every answer with the mirrored market's answer
CTB_SYMMETRIZE=1
# events: trade only on bars with a market event | every_bar
CTB_TRADE_TRIGGER=events
# model | flow | agree
CTB_DIRECTION_SOURCE=model
CTB_REQUIRE_BIG_MOVE=1
# strict trades only on symbols with out-of-sample skill (VALID screen)
CTB_REQUIRE_VALIDATED=1
# base | pause | alert
CTB_DRIFT_ACTION=base
CTB_DYNAMIC_SIZING=1
# stop to break-even after +1R (0 = off)
CTB_BE_TRIGGER_R=1.0
# extra models blended with the primary
# CTB_ENSEMBLE=kairos
# e.g. trend_up/normal_vol,range/low_vol
# CTB_ALLOWED_REGIMES=
